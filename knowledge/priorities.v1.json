  "conflicts": [
    {
      "id": "glossary-enemy-balance",
      "statement": "The glossary describes the Enemy Balance card as shifting the spawn mix toward fewer enemies, while its dedicated card page says equipping it increases the number of enemies spawned per wave - opposite directions for the same card the gem/card priority list ranks second to unlock.",
      "tainted": ["priority.cards.unlock_order"],
      "sources": ["wiki-glossary", "wiki-enemy-balance-card"],
      "quote": "Glossary: 'Shifts the spawn mix away from the swarm and toward fewer, meatier enemies.' Card page: 'While it is equipped, more enemies appear in each wave, and every kill pays out more cash than usual.'"
    },
    {
      "id": "icetae-list-version-dated",
      "statement": "IceTae's gem-and-card priority list self-dates to game version 0.16-0.17 and is not corroborated against the current game state; treating its spend order as current risks an autonomous director spending gems and stones on stale advice.",
      "tainted": ["priority.gems.spend_order", "priority.cards.unlock_order"],
      "sources": ["wiki-icetae-priority-list"],
      "quote": "This priority list comes from Discord user IceTæ#6224... It was put together around game version 0.16 and was still considered current as of 0.17."
    },
    {
      "id": "uw-plus-ability-cost",
      "statement": "The Ultimate Weapons overview describes Ultimate Weapon Plus ability costs as escalating with each purchase, while the newer UW tier list states a flat 975 stones per ability; do not hardcode either figure without current in-game confirmation.",
      "tainted": ["priority.uw.plus_ability_cost"],
      "sources": ["wiki-ultimate-weapons", "wiki-uw-tier-list"],
      "quote": "Ultimate Weapons: 'Each purchase increases the cost of the next ability.' UW tier list: 'Each UW+ ability (Smite, Golden Combo, Kill Wall …) additionally costs a flat 975 stones to unlock in-game.'"
    }
  ],
