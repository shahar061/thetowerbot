.venv/
__pycache__/
*.pyc
screen*.png
unknown/
.bifrost-worktrees/

# Local research, implementation notes, and agent workspaces.
/docs/
/.claude/
/.codex/
/.superpowers/
/.worktrees/
/worktrees/
/research/

# Local caches, editor metadata, and unpublished UI staging directories.
.DS_Store
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.tsbuildinfo
/web/.static-publish-*/

# Local credentials; checked-in examples remain available.
.env
.env.*
!.env.example
!.env.sample

# The event log is machine-local state, not source.
tower_bot.db
tower_bot.db-wal
tower_bot.db-shm
advisor.json
.advisor*.tmp

# Next.js UI build artefacts. web/static/ is deliberately NOT ignored - it is
# the committed build the bot serves with no node installed.
web/ui/node_modules/
web/ui/.next/
web/ui/out/
web/ui/.eslintcache

# Atomic-save temp files. The profiles themselves ARE committed - a strategy
# is a decision worth reviewing in a diff.
strategies/.*.tmp

# The active-profile pointer is per-machine runtime state, not a decision -
# set_active() rewrites it, so it belongs with tower_bot.db* above, not with
# the profile definitions beside it.
strategies/.active

# Staging output from tools/harvest_speed_glyphs.py - unlabelled crops that
# get renamed into templates/speed/ by hand, not artefacts to commit.
templates/speed/harvest/
