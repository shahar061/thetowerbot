# Copy to .env (git-ignored) and fill in. tower_bot.py loads it at startup;
# a variable already exported in the shell wins over this file.

# Optional model recovery (see README "Optional model recovery").
CLAUDE_OPENROUTER_API_KEY=

# Optional Telegram status digests. Both must be set to enable them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
